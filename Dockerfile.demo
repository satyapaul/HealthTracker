# Single-process CX demo image: builds the SPA + api, then runs the local HTTP
# harness serving BOTH the built SPA and the seeded in-memory API from one
# origin. NO AWS, NO database — all data is in-memory harness fixtures and
# resets on restart. For sharing/review only, not production.
#
# Build:  docker build -f Dockerfile.demo -t postopcare-demo .
# Run:    docker run --rm -p 8080:8080 postopcare-demo
# Open:   http://localhost:8080  (demo login shown on the welcome screen)

# ---- build stage ----------------------------------------------------------
FROM node:22-bookworm-slim AS build
WORKDIR /app

# Install all workspace deps (lockfile-driven).
COPY package.json package-lock.json ./
COPY tsconfig.base.json eslint.config.mjs ./
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
COPY apps/api/layers/common/nodejs/package.json apps/api/layers/common/nodejs/
COPY infra/package.json infra/
COPY db/package.json db/
RUN npm ci

# Copy sources and build the demo (api dist + web dist, same-origin + demo mode).
COPY . .
RUN npm run demo:build

# ---- run stage ------------------------------------------------------------
FROM node:22-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV WEB_DIST=/app/apps/web/dist

# Bring the built artifacts + the installed node_modules (the harness only uses
# node built-ins + in-memory fakes at runtime, so this is sufficient).
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/web/dist ./apps/web/dist
COPY --from=build /app/package.json ./package.json

EXPOSE 8080
CMD ["node", "apps/api/dist/harness/server.js"]
