{
  "name": "postopcare-infra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --passWithNoTests",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy:all": "cdk deploy --all --require-approval never",
    "deploy:networking": "cdk deploy PostOpCare-Networking-* --require-approval never",
    "deploy:database": "cdk deploy PostOpCare-Database-* --require-approval never",
    "deploy:redis": "cdk deploy PostOpCare-Redis-* --require-approval never",
    "deploy:storage": "cdk deploy PostOpCare-Storage-* --require-approval never",
    "deploy:messaging": "cdk deploy PostOpCare-Messaging-* --require-approval never",
    "deploy:data": "cdk deploy PostOpCare-Data-* --require-approval never",
    "deploy:compute": "cdk deploy PostOpCare-Compute-* --require-approval never",
    "deploy:observability": "cdk deploy PostOpCare-Observability-* --require-approval never",
    "deploy:edge": "cdk deploy PostOpCare-Edge-* --require-approval never"
  },
  "dependencies": {
    "aws-cdk-lib": "2.155.0",
    "constructs": "10.3.0",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "22.5.0",
    "aws-cdk": "2.155.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
